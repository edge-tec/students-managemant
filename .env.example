# Database connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/edubd_db"

# Authentication Secrets
JWT_SECRET="replace_with_secure_random_string_in_production"
NEXTAUTH_SECRET="replace_with_secure_random_string_in_production"

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="bn"

# AI Study Assistant (Gemini / AI integration)
GEMINI_API_KEY=""

# Payment Gateways (bKash / Nagad / SSLCommerz)
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
NAGAD_MERCHANT_ID=""
NAGAD_PUBLIC_KEY=""
NAGAD_PRIVATE_KEY=""

# Email & Storage (SMTP & S3)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp_user"
SMTP_PASS="smtp_pass"
SMTP_FROM="noreply@edubd.ac"
