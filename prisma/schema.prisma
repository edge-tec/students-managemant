// Prisma Schema for Bilingual Educational Platform for Bangladesh
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------------------

enum UserRoleType {
  STUDENT
  TEACHER
  CONTENT_REVIEWER
  CONTENT_MANAGER
  SUPPORT_AGENT
  FINANCE_MANAGER
  ADMIN
  SUPER_ADMIN
}

enum EnrollmentStatus {
  ACTIVE
  TRANSFERRED
  COMPLETED
  DROPPED
}

enum ExamCategoryType {
  SSC
  HSC
  MEDICAL
  DENTAL
  UNIVERSITY
  MODEL_TEST
}

enum QuestionType {
  MCQ
  CQ
  FILL_IN_BLANK
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum ContentStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum ExamMode {
  PRACTICE
  REAL_EXAM
}

enum ExamSessionStatus {
  CREATED
  IN_PROGRESS
  SUBMITTED
  EXPIRED
  EVALUATED
}

enum ExamType {
  PRACTICE
  CHAPTER_TEST
  SUBJECT_TEST
  MODEL_TEST
  FULL_SYLLABUS
  ADMISSION_TEST
  MEDICAL_ADMISSION
  UNIVERSITY_ADMISSION
  CUSTOM
}

enum ExamStatus {
  DRAFT
  REVIEW
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum ExamAccessType {
  FREE
  SUBSCRIPTION_ONLY
  PAID
}

enum ResultReleasePolicy {
  IMMEDIATE
  AFTER_EXAM_WINDOW
  MANUAL
}

enum FinalizationReason {
  STUDENT_SUBMIT
  TIMEOUT_AUTO_SUBMIT
  ADMIN_RESOLVED
  ABANDONED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  VERIFIED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  BKASH
  NAGAD
  BANK_TRANSFER
  CARD
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  GRACE_PERIOD
}

enum DoubtStatus {
  OPEN
  ASSIGNED
  ANSWERED
  RESOLVED
}

enum ResourceType {
  NOTES
  SLIDES
  FORMULA_SHEET
  MODEL_PAPER
  SUGGESTION
  PDF_BOOK
}

enum ReportReason {
  WRONG_ANSWER
  TYPO_OR_GRAMMAR
  INCOMPLETE_QUESTION
  IMAGE_OR_FORMULA_BROKEN
  OUT_OF_SYLLABUS
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

// -------------------------------------------------------------------------
// USER, AUTH & PROFILES
// -------------------------------------------------------------------------

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  phoneNumber   String?        @unique
  passwordHash  String
  fullName      String
  fullNameBn    String?
  avatarUrl     String?
  isVerified    Boolean        @default(false)
  verificationToken String?
  isActive      Boolean        @default(true)
  preferredLang String         @default("bn") // "bn" or "en"
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  profile       UserProfile?
  userRoles     UserRole[]
  preferences   StudentPreference?
  
  // Relations to academic & exam activities
  examSessions  ExamSession[]
  examResults   ExamResult[]
  wrongQuestions WrongQuestion[]
  bookmarks     Bookmark[]
  collections   PersonalQuestionCollection[]
  enrollments   CourseEnrollment[]
  progress      LearningProgress[]
  studyTargets  StudyTarget[]
  studyActivities StudyActivity[]
  studyStreaks  StudyStreak[]
  subscriptions Subscription[]
  paymentOrders PaymentOrder[]
  doubtTickets  DoubtTicket[]  @relation("StudentDoubts")
  answeredDoubts DoubtResponse[] @relation("TeacherResponses")
  notifications Notification[]
  notificationPref NotificationPreference?
  auditLogs     AuditLog[]
  importJobs    ImportJob[]
  assignedReviews ContentReview[] @relation("ReviewerAssigned")
  createdQuestions Question[]  @relation("QuestionAuthor")
  questionReports QuestionReport[]
  createdExams    Exam[]       @relation("ExamAuthor")
  manualGradesGiven ManualGrade[] @relation("GraderUser")
  manualGradesReviewed ManualGrade[] @relation("GraderReviewer")
  examAuditEvents ExamAuditEvent[] @relation("AuditUser")
  teacherAssignments TeacherAssignment[] @relation("TeacherAssignments")
  assignedTeachers   TeacherAssignment[] @relation("TeacherAssigner")
  classEnrollments   ClassEnrollment[]   @relation("StudentClassEnrollments")
  pdfImports         PdfImport[]         @relation("UserPdfImports")
  textEdits          DocumentTextVersion[] @relation("UserTextEdits")
  questionGenJobs    QuestionGenerationJob[] @relation("UserQuestionGenJobs")
  questionReviewEvents QuestionReviewEvent[] @relation("UserQuestionReviewEvents")

  @@index([email])
  @@index([phoneNumber])
}

model UserProfile {
  id              String         @id @default(uuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetCategory  ExamCategoryType?
  institutionName String?
  hscYear         Int?
  sscYear         Int?
  district        String?
  division        String?
  bio             String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Role {
  id          String         @id @default(uuid())
  name        UserRoleType   @unique
  description String?
  permissions Permission[]
  userRoles   UserRole[]
}

model Permission {
  id          String   @id @default(uuid())
  roleId      String
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  action      String   // e.g. "create:question", "publish:content", "manage:users"
  resource    String   // e.g. "question", "exam", "finance"
  createdAt   DateTime @default(now())

  @@unique([roleId, action, resource])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
}

model StudentPreference {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  examCategory   ExamCategoryType @default(SSC)
  currentClassId String?
  soundEnabled   Boolean   @default(true)
  timerWarningMin Int      @default(5)
  showExplanationImmediately Boolean @default(true)
  updatedAt      DateTime  @updatedAt
}

// -------------------------------------------------------------------------
// CURRICULUM ARCHITECTURE (SSC, HSC, MEDICAL, UNIVERSITY)
// -------------------------------------------------------------------------

model AcademicClass {
  id          String        @id @default(uuid())
  code        String        @unique // e.g. "CLASS_9", "CLASS_10", "CLASS_11", "CLASS_12", "ADMISSION"
  nameEn      String
  nameBn      String
  orderIndex  Int           @default(0)
  isActive    Boolean       @default(true)
  subjects    Subject[]
  exams       Exam[]
  teacherAssignments TeacherAssignment[]
  classEnrollments   ClassEnrollment[]
  pdfImports         PdfImport[]
  createdAt   DateTime      @default(now())
}

model AcademicGroup {
  id          String        @id @default(uuid())
  code        String        @unique // e.g. "SCIENCE", "COMMERCE", "HUMANITIES", "GENERAL", "VOCATIONAL"
  nameEn      String
  nameBn      String
  orderIndex  Int           @default(0)
  isActive    Boolean       @default(true)
  subjects    Subject[]
  createdAt   DateTime      @default(now())
}

model ExaminationBoard {
  id          String        @id @default(uuid())
  code        String        @unique // e.g. "DHA", "RAJ", "CTG", "BAR", "COM", "DIN", "JES", "MYM", "SYL", "MAD", "TEC"
  nameEn      String
  nameBn      String
  isActive    Boolean       @default(true)
  questions   QuestionReference[]
  exams       Exam[]
}

model University {
  id          String         @id @default(uuid())
  code        String         @unique // e.g. "DU", "RU", "CU", "JU", "GST", "AGRI", "BUET", "DMC"
  nameEn      String
  nameBn      String
  shortName   String
  admissionUnits AdmissionUnit[]
  questions   QuestionReference[]
}

model AdmissionUnit {
  id            String       @id @default(uuid())
  universityId  String
  university    University   @relation(fields: [universityId], references: [id], onDelete: Cascade)
  code          String       // e.g. "KA", "KHA", "GA", "A", "B", "C"
  nameEn        String
  nameBn        String
  focusGroup    String?      // Science, Arts, Commerce
  questions     QuestionReference[]

  @@unique([universityId, code])
}

model Subject {
  id          String         @id @default(uuid())
  code        String         @unique // e.g. "PHY_1", "CHEM_1", "BIO_1", "MATH_1", "ENG", "BAN"
  nameEn      String
  nameBn      String
  category    ExamCategoryType
  classId     String?
  academicClass AcademicClass? @relation(fields: [classId], references: [id])
  groupId     String?
  academicGroup AcademicGroup? @relation(fields: [groupId], references: [id])
  papers      Paper[]
  books       Book[]
  chapters    Chapter[]
  questions   Question[]
  courses     Course[]
  libraryResources LibraryResource[]
  doubtTickets DoubtTicket[]
  exams       Exam[]
  teacherAssignments TeacherAssignment[]
  pdfImports         PdfImport[]
  draftQuestions     GeneratedQuestionDraft[]
  orderIndex  Int            @default(0)
  isActive    Boolean        @default(true)

  @@index([category])
  @@index([classId])
  @@index([groupId])
}

model Paper {
  id          String         @id @default(uuid())
  subjectId   String
  subject     Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  paperNumber Int            // 1 or 2
  nameEn      String         // "1st Paper" / "2nd Paper"
  nameBn      String         // "১ম পত্র" / "২য় পত্র"
  chapters    Chapter[]
  questions   Question[]
  exams       Exam[]
  isActive    Boolean        @default(true)

  @@unique([subjectId, paperNumber])
}

model Book {
  id          String         @id @default(uuid())
  subjectId   String
  subject     Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  titleEn     String
  titleBn     String
  author      String?
  publisher   String?
  edition     String?
}

model Chapter {
  id          String         @id @default(uuid())
  subjectId   String
  subject     Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  paperId     String?
  paper       Paper?         @relation(fields: [paperId], references: [id])
  chapterNum  Int
  nameEn      String
  nameBn      String
  description String?
  topics      Topic[]
  questions   Question[]
  lessons     Lesson[]
  libraryResources LibraryResource[]
  exams       Exam[]
  pdfImports  PdfImport[]
  draftQuestions GeneratedQuestionDraft[]
  orderIndex  Int            @default(0)
  isActive    Boolean        @default(true)

  @@index([subjectId, chapterNum])
}

model Topic {
  id          String         @id @default(uuid())
  chapterId   String
  chapter     Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  nameEn      String
  nameBn      String
  orderIndex  Int            @default(0)
  isActive    Boolean        @default(true)
  questions   Question[]
}

// -------------------------------------------------------------------------
// QUESTION BANK & VERIFIED HISTORICAL REFERENCES
// -------------------------------------------------------------------------

model Question {
  id                String            @id @default(uuid())
  slug              String            @unique @default(cuid())
  type              QuestionType      @default(MCQ)
  difficulty        DifficultyLevel   @default(MEDIUM)
  status            ContentStatus     @default(PUBLISHED)
  isPremium         Boolean           @default(false)
  
  // Bilingual Content
  questionTextBn    String
  questionTextEn    String?
  
  // Marks & Rules
  marks             Float             @default(1.0)
  negativeMarks     Float             @default(0.25)
  estimatedSeconds  Int               @default(60)

  // Academic hierarchy
  category          ExamCategoryType
  subjectId         String
  subject           Subject           @relation(fields: [subjectId], references: [id])
  paperId           String?
  paper             Paper?            @relation(fields: [paperId], references: [id])
  chapterId         String
  chapter           Chapter           @relation(fields: [chapterId], references: [id])
  topicId           String?
  topic             Topic?            @relation(fields: [topicId], references: [id])

  // Context & Textbook
  textbookRef       String?
  teacherTipsBn     String?
  teacherTipsEn     String?
  stemBn            String?           // Stimulus / উদ্দীপক for CQ (Creative Questions)
  stemEn            String?
  diagramUrl        String?           // Image, table, or diagram URL

  authorId          String?
  author            User?             @relation("QuestionAuthor", fields: [authorId], references: [id])
  pdfImportId       String?
  pdfImport         PdfImport?        @relation(fields: [pdfImportId], references: [id], onDelete: SetNull)
  sourceDraft       GeneratedQuestionDraft?

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Child Relations
  options           QuestionOption[]
  subparts          QuestionSubpart[] // CQ (ক, খ, গ, ঘ) subparts with marks
  answer            QuestionAnswer?
  references        QuestionReference[]
  tags              QuestionTag[]
  revisions         QuestionRevision[]
  reviews           ContentReview[]
  reports           QuestionReport[]
  sessionQuestions  ExamSessionQuestion[]
  examQuestions     ExamQuestion[]
  studentAnswers    StudentAnswer[]
  wrongQuestionEntries WrongQuestion[]
  bookmarks         Bookmark[]
  collectionItems   PersonalQuestionCollectionItem[]

  // Self-relation for similar questions
  similarQuestions  SimilarQuestion[] @relation("SourceQuestion")
  referencedBy      SimilarQuestion[] @relation("SimilarTarget")

  @@index([category, subjectId, chapterId])
  @@index([status])
  @@index([difficulty])
}

model QuestionOption {
  id          String      @id @default(uuid())
  questionId  String
  question    Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionKey   String      // "A", "B", "C", "D"
  textBn      String
  textEn      String?
  isCorrect   Boolean     @default(false)
  orderIndex  Int         @default(0)

  @@unique([questionId, optionKey])
}

model QuestionSubpart {
  id              String   @id @default(uuid())
  questionId      String
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  partLabel       String   // "ক", "খ", "গ", "ঘ" or "a", "b", "c", "d"
  questionTextBn  String
  questionTextEn  String?
  marks           Float    // e.g. 1.0, 2.0, 3.0, 4.0
  solutionBn      String
  solutionEn      String?
  markingGuidance String?  // Rubric / marking criteria
  orderIndex      Int      @default(0)

  @@unique([questionId, partLabel])
}

model QuestionAnswer {
  id            String    @id @default(uuid())
  questionId    String    @unique
  question      Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  correctKey    String    // "A", "B", "C", or "D"
  explanationBn String
  explanationEn String?
}

model QuestionReport {
  id          String       @id @default(uuid())
  questionId  String
  question    Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  reason      ReportReason @default(OTHER)
  description String?
  status      ReportStatus @default(PENDING)
  adminNotes  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([questionId])
  @@index([status])
}

model QuestionReference {
  id              String             @id @default(uuid())
  questionId      String
  question        Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  boardId         String?
  board           ExaminationBoard?  @relation(fields: [boardId], references: [id])
  universityId    String?
  university      University?        @relation(fields: [universityId], references: [id])
  admissionUnitId String?
  admissionUnit   AdmissionUnit?     @relation(fields: [admissionUnitId], references: [id])
  examYear        Int
  examSessionName String?            // e.g. "Medical Admission Test 2023-24", "Dhaka Board 2022"

  @@index([boardId, examYear])
  @@index([universityId, examYear])
}

model QuestionTag {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag        String

  @@unique([questionId, tag])
}

model SimilarQuestion {
  id                String   @id @default(uuid())
  sourceQuestionId  String
  sourceQuestion    Question @relation("SourceQuestion", fields: [sourceQuestionId], references: [id], onDelete: Cascade)
  similarQuestionId String
  similarQuestion   Question @relation("SimilarTarget", fields: [similarQuestionId], references: [id], onDelete: Cascade)
  similarityScore   Float    @default(1.0)

  @@unique([sourceQuestionId, similarQuestionId])
}

model QuestionRevision {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  changedBy  String
  diffJson   String   // JSON string of fields changed
  reason     String?
  createdAt  DateTime @default(now())
}

model ContentReview {
  id          String        @id @default(uuid())
  questionId  String
  question    Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  reviewerId  String
  reviewer    User          @relation("ReviewerAssigned", fields: [reviewerId], references: [id])
  status      ContentStatus
  comments    String?
  reviewedAt  DateTime      @default(now())
}

// -------------------------------------------------------------------------
// EXAMINATION ENGINE & ATTEMPTS
// -------------------------------------------------------------------------

model ExamTemplate {
  id               String           @id @default(uuid())
  titleBn          String
  titleEn          String
  category         ExamCategoryType
  subjectId        String?
  durationMinutes  Int
  totalMarks       Float
  negativeMarks    Float            @default(0.25)
  questionCount    Int
  isPublished      Boolean          @default(true)
  isPremium        Boolean          @default(false)
  mode             ExamMode         @default(REAL_EXAM)
  instructionsBn   String?
  instructionsEn   String?
  sessions         ExamSession[]
  createdAt        DateTime         @default(now())
}

model Exam {
  id                  String              @id @default(uuid())
  titleBn             String
  titleEn             String
  descriptionBn       String?
  descriptionEn       String?
  category            ExamCategoryType
  examType            ExamType            @default(MODEL_TEST)
  
  academicClassId     String?
  academicClass       AcademicClass?      @relation(fields: [academicClassId], references: [id])
  subjectId           String?
  subject             Subject?            @relation(fields: [subjectId], references: [id])
  paperId             String?
  paper               Paper?              @relation(fields: [paperId], references: [id])
  chapterId           String?
  chapter             Chapter?            @relation(fields: [chapterId], references: [id])
  boardId             String?
  board               ExaminationBoard?   @relation(fields: [boardId], references: [id])
  examYear            Int?
  
  durationMinutes     Int
  totalMarks          Float
  passMarks           Float?
  negativeMarks       Float               @default(0.25)
  questionCount       Int
  
  randomizeQuestions  Boolean             @default(true)
  randomizeOptions    Boolean             @default(true)
  
  startDate           DateTime?
  endDate             DateTime?
  maxAttempts         Int?                @default(1)
  
  status              ExamStatus          @default(DRAFT)
  accessType          ExamAccessType      @default(FREE)
  priceBdt            Float?
  
  releasePolicy       ResultReleasePolicy @default(IMMEDIATE)
  isResultsReleased   Boolean             @default(true)
  version             Int                 @default(1)
  
  instructionsBn      String?
  instructionsEn      String?
  allowedResources    String?
  
  authorId            String?
  author              User?               @relation("ExamAuthor", fields: [authorId], references: [id])
  
  sections            ExamSection[]
  examQuestions       ExamQuestion[]
  sessions            ExamSession[]
  auditEvents         ExamAuditEvent[]
  
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([category, status])
  @@index([subjectId, status])
}

model ExamSection {
  id              String         @id @default(uuid())
  examId          String
  exam            Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  titleBn         String
  titleEn         String
  descriptionBn   String?
  descriptionEn   String?
  durationMinutes Int?
  totalMarks      Float?
  orderIndex      Int            @default(1)
  
  questions       ExamQuestion[]
  createdAt       DateTime       @default(now())

  @@index([examId, orderIndex])
}

model ExamQuestion {
  id            String       @id @default(uuid())
  examId        String
  exam          Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  sectionId     String?
  section       ExamSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  questionId    String
  question      Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  orderIndex    Int
  marks         Float        @default(1.0)
  negativeMarks Float        @default(0.25)

  @@unique([examId, questionId])
  @@index([examId, orderIndex])
}

model ExamSession {
  id                 String               @id @default(uuid())
  studentId          String
  student            User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  examId             String?
  exam               Exam?                @relation(fields: [examId], references: [id])
  templateId         String?
  template           ExamTemplate?        @relation(fields: [templateId], references: [id])
  
  category           ExamCategoryType
  mode               ExamMode             @default(REAL_EXAM)
  status             ExamSessionStatus    @default(CREATED)
  
  // Server-authoritative timing
  durationMinutes    Int
  serverStartTime    DateTime             @default(now())
  serverDeadline     DateTime
  submittedAt        DateTime?
  finalizationReason FinalizationReason?

  // Snapshot of marking configuration
  correctMark        Float                @default(1.0)
  negativeMark       Float                @default(0.25)
  totalQuestions     Int
  attemptNumber      Int                  @default(1)

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  sessionQuestions   ExamSessionQuestion[]
  studentAnswers     StudentAnswer[]
  result             ExamResult?
  auditEvents        ExamAuditEvent[]

  @@index([studentId, status])
  @@index([examId, studentId])
}

model ExamSessionQuestion {
  id          String      @id @default(uuid())
  sessionId   String
  session     ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question    @relation(fields: [questionId], references: [id])
  orderIndex  Int

  @@unique([sessionId, questionId])
  @@index([sessionId, orderIndex])
}

model StudentAnswer {
  id                String       @id @default(uuid())
  sessionId         String
  session           ExamSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId        String
  question          Question     @relation(fields: [questionId], references: [id])
  selectedOption    String?      // "A", "B", "C", "D" or null
  writtenAnswer     String?      // For Short-Answer / CQ questions
  isCorrect         Boolean?
  marksObtained     Float?
  timeSpentSec      Int          @default(0)
  isMarkedForReview Boolean      @default(false)
  savedAt           DateTime     @default(now())
  manualGrade       ManualGrade?

  @@unique([sessionId, questionId])
}

model ManualGrade {
  id             String        @id @default(uuid())
  answerId       String        @unique
  answer         StudentAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  graderId       String
  grader         User          @relation("GraderUser", fields: [graderId], references: [id])
  marksAwarded   Float
  maxMarks       Float
  rubricFeedback String?
  gradedAt       DateTime      @default(now())
  
  reviewerId     String?
  reviewer       User?         @relation("GraderReviewer", fields: [reviewerId], references: [id])
  reviewedAt     DateTime?
  reviewNotes    String?
}

model ExamAuditEvent {
  id           String       @id @default(uuid())
  examId       String?
  exam         Exam?        @relation(fields: [examId], references: [id], onDelete: Cascade)
  sessionId    String?
  session      ExamSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId       String
  user         User         @relation("AuditUser", fields: [userId], references: [id], onDelete: Cascade)
  action       String
  metadataJson String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime     @default(now())

  @@index([examId, action])
  @@index([sessionId, action])
  @@index([userId, createdAt])
}

model ExamResult {
  id                   String      @id @default(uuid())
  sessionId            String      @unique
  session              ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId            String
  student              User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  totalScore           Float
  maxMarks             Float
  correctCount         Int
  incorrectCount       Int
  unansweredCount      Int
  accuracyPct          Float
  timeSpentSec         Int
  
  rankInCohort         Int?
  cohortSize           Int?
  percentile           Float?
  isPassed             Boolean?

  subjectBreakdownJson String // JSON containing per-subject score and accuracy
  chapterBreakdownJson String // JSON containing per-chapter performance
  sectionBreakdownJson String?
  
  isPublished          Boolean     @default(true)
  regradedAt           DateTime?
  regradeReason        String?
  regradedBy           String?

  evaluatedAt          DateTime    @default(now())

  @@index([studentId])
}

model WrongQuestion {
  id           String      @id @default(uuid())
  studentId    String
  student      User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  mistakeCount Int         @default(1)
  isMastered   Boolean     @default(false)
  lastMistake  DateTime    @default(now())
  masteredAt   DateTime?

  @@unique([studentId, questionId])
  @@index([studentId, isMastered])
}

model Bookmark {
  id         String   @id @default(uuid())
  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([studentId, questionId])
}

model PersonalQuestionCollection {
  id          String                           @id @default(uuid())
  studentId   String
  student     User                             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name        String
  description String?
  items       PersonalQuestionCollectionItem[]
  createdAt   DateTime                         @default(now())
}

model PersonalQuestionCollectionItem {
  id           String                     @id @default(uuid())
  collectionId String
  collection   PersonalQuestionCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question                   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  addedAt      DateTime                   @default(now())

  @@unique([collectionId, questionId])
}

// -------------------------------------------------------------------------
// DIGITAL LIBRARY & ONLINE CLASSROOM
// -------------------------------------------------------------------------

model Course {
  id           String             @id @default(uuid())
  titleBn      String
  titleEn      String
  description  String?
  category     ExamCategoryType
  subjectId    String?
  subject      Subject?           @relation(fields: [subjectId], references: [id])
  thumbnailUrl String?
  isPremium    Boolean            @default(false)
  isPublished  Boolean            @default(true)
  lessons      Lesson[]
  enrollments  CourseEnrollment[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model CourseEnrollment {
  id         String   @id @default(uuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  @@unique([courseId, studentId])
}

model Lesson {
  id          String             @id @default(uuid())
  courseId    String
  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapterId   String?
  chapter     Chapter?           @relation(fields: [chapterId], references: [id])
  titleBn     String
  titleEn     String
  videoUrl    String?            // Video stream URL / playback identifier
  durationSec Int                @default(0)
  orderIndex  Int                @default(0)
  resources   LessonResource[]
  progress    LearningProgress[]
}

model LessonResource {
  id        String   @id @default(uuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title     String
  fileUrl   String
  fileType  String
  createdAt DateTime @default(now())
}

model LearningProgress {
  id            String    @id @default(uuid())
  studentId     String
  student       User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId      String
  lesson        Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  watchDuration Int       @default(0)
  isCompleted   Boolean   @default(false)
  completedAt   DateTime?

  @@unique([studentId, lessonId])
}

model LibraryResource {
  id          String           @id @default(uuid())
  titleBn     String
  titleEn     String
  description String?
  type        ResourceType     @default(NOTES)
  category    ExamCategoryType
  subjectId   String?
  subject     Subject?         @relation(fields: [subjectId], references: [id])
  chapterId   String?
  chapter     Chapter?         @relation(fields: [chapterId], references: [id])
  fileUrl     String
  fileSizeMb  Float            @default(1.0)
  isPremium   Boolean          @default(false)
  viewCount   Int              @default(0)
  downloadCount Int            @default(0)
  createdAt   DateTime         @default(now())
}

// -------------------------------------------------------------------------
// STUDENT ENGAGEMENT, STREAKS & TARGETS
// -------------------------------------------------------------------------

model StudyTarget {
  id             String    @id @default(uuid())
  studentId      String
  student        User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  targetDate     DateTime  @default(now())
  targetQuestions Int      @default(20)
  completedQuestions Int   @default(0)
  isCompleted    Boolean   @default(false)

  @@unique([studentId, targetDate])
}

model StudyActivity {
  id           String   @id @default(uuid())
  studentId    String
  student      User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  activityType String   // "EXAM_TAKEN", "LESSON_WATCHED", "PRACTICE_SOLVED"
  durationMin  Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([studentId, createdAt])
}

model StudyStreak {
  id            String    @id @default(uuid())
  studentId     String    @unique
  student       User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  currentStreak Int       @default(1)
  longestStreak Int       @default(1)
  lastActiveDay DateTime  @default(now())
}

// -------------------------------------------------------------------------
// BILLING, SUBSCRIPTIONS & PAYMENT PROVIDERS
// -------------------------------------------------------------------------

model SubscriptionPlan {
  id             String           @id @default(uuid())
  code           String           @unique // "FREE", "SSC_PREMIUM", "HSC_PREMIUM", "MED_PREMIUM", "VARSITY_PREMIUM", "ALL_ACCESS"
  nameBn         String
  nameEn         String
  descriptionBn  String?
  descriptionEn  String?
  priceBdt       Float
  durationDays   Int              @default(30)
  category       ExamCategoryType?
  featuresJson   String           // JSON array of feature descriptions
  isActive       Boolean          @default(true)
  subscriptions  Subscription[]
  paymentOrders  PaymentOrder[]
}

model Subscription {
  id         String             @id @default(uuid())
  studentId  String
  student    User               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  planId     String
  plan       SubscriptionPlan   @relation(fields: [planId], references: [id])
  status     SubscriptionStatus @default(ACTIVE)
  startDate  DateTime           @default(now())
  endDate    DateTime
  orderId    String?            @unique
  order      PaymentOrder?      @relation(fields: [orderId], references: [id])
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([studentId, status])
}

model PaymentOrder {
  id             String               @id @default(uuid())
  orderNumber    String               @unique // e.g. "ORD-2026-X83921"
  studentId      String
  student        User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  planId         String
  plan           SubscriptionPlan     @relation(fields: [planId], references: [id])
  amountBdt      Float
  paymentMethod  PaymentMethod        @default(BKASH)
  status         PaymentStatus        @default(PENDING)
  providerTxId   String?              @unique
  notes          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  transactions   PaymentTransaction[]
  subscription   Subscription?
  refunds        Refund[]

  @@index([studentId, status])
}

model PaymentTransaction {
  id            String        @id @default(uuid())
  orderId       String
  order         PaymentOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gateway       PaymentMethod
  gatewayTxId   String
  amount        Float
  currency      String        @default("BDT")
  rawCallback   String?       // JSON payload received from payment provider
  isVerified    Boolean       @default(false)
  createdAt     DateTime      @default(now())

  @@unique([gateway, gatewayTxId])
}

model Refund {
  id          String        @id @default(uuid())
  orderId     String
  order       PaymentOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amountBdt   Float
  reason      String
  processedAt DateTime      @default(now())
}

// -------------------------------------------------------------------------
// DOUBT SOLVING & NOTIFICATIONS
// -------------------------------------------------------------------------

model DoubtTicket {
  id          String          @id @default(uuid())
  studentId   String
  student     User            @relation("StudentDoubts", fields: [studentId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject         @relation(fields: [subjectId], references: [id])
  title       String
  questionBn  String
  imageUrl    String?
  status      DoubtStatus     @default(OPEN)
  responses   DoubtResponse[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([studentId, status])
}

model DoubtResponse {
  id          String      @id @default(uuid())
  ticketId    String
  ticket      DoubtTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     User        @relation("TeacherResponses", fields: [teacherId], references: [id], onDelete: Cascade)
  responseBn  String
  imageUrl    String?
  createdAt   DateTime    @default(now())
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleBn     String
  titleEn     String
  messageBn   String
  messageEn   String
  linkUrl     String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, isRead])
}

model NotificationPreference {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailExam   Boolean  @default(true)
  emailClass  Boolean  @default(true)
  emailBilling Boolean @default(true)
  inAppExam   Boolean  @default(true)
  inAppClass  Boolean  @default(true)
  inAppBilling Boolean @default(true)
}

// -------------------------------------------------------------------------
// ADMIN, IMPORT ENGINE, AUDIT & SYSTEM
// -------------------------------------------------------------------------

model ImportJob {
  id              String        @id @default(uuid())
  fileName        String
  uploadedById    String
  uploadedBy      User          @relation(fields: [uploadedById], references: [id])
  totalRows       Int           @default(0)
  successfulRows  Int           @default(0)
  failedRows      Int           @default(0)
  status          String        @default("PROCESSING") // "PROCESSING", "COMPLETED", "FAILED"
  errors          ImportError[]
  createdAt       DateTime      @default(now())
}

model ImportError {
  id          String    @id @default(uuid())
  jobId       String
  job         ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rowNumber   Int
  columnName  String?
  errorMessage String
  rowDataJson String?
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String   // e.g. "USER_ROLE_UPDATED", "QUESTION_APPROVED", "PAYMENT_REFUNDED"
  resource    String
  resourceId  String?
  detailsJson String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([action, resource])
}

model SiteSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

// -------------------------------------------------------------------------
// ACADEMIC ADMINISTRATION: TEACHER ASSIGNMENTS & STUDENT ENROLLMENTS
// -------------------------------------------------------------------------

model TeacherAssignment {
  id             String         @id @default(uuid())
  teacherId      String
  teacher        User           @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classId        String?
  academicClass  AcademicClass? @relation(fields: [classId], references: [id], onDelete: SetNull)
  assignedById   String?
  assignedBy     User?          @relation("TeacherAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  isActive       Boolean        @default(true)
  notes          String?
  assignedAt     DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([teacherId, subjectId])
  @@index([teacherId, isActive])
  @@index([subjectId])
}

model ClassEnrollment {
  id             String           @id @default(uuid())
  studentId      String
  student        User             @relation("StudentClassEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  classId        String
  academicClass  AcademicClass    @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear   String           @default("2025-2026")
  rollNumber     String?
  status         EnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime         @default(now())
  transferredAt  DateTime?
  transferReason String?
  notes          String?
  updatedAt      DateTime         @updatedAt

  @@unique([studentId, classId, academicYear])
  @@index([studentId, status])
  @@index([classId, status])
}

// -------------------------------------------------------------------------
// PDF IMPORT, TEXT EXTRACTION & AI QUESTION GENERATION ENGINE
// -------------------------------------------------------------------------

enum PdfImportStatus {
  PENDING
  QUEUED
  EXTRACTING
  RUNNING_OCR
  READY
  FAILED
  CANCELLED
}

enum GenerationJobStatus {
  PENDING
  PREPARING_CONTEXT
  GENERATING
  VALIDATING
  COMPLETED
  FAILED
}

enum DraftQuestionStatus {
  DRAFT
  REVIEW
  APPROVED
  REJECTED
  IMPORTED
}

enum AiQuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER
  DESCRIPTIVE
  FILL_IN_BLANK
  MATCHING
  ANALYTICAL
  HIGHER_ORDER
}

model PdfImport {
  id                String            @id @default(uuid())
  fileName          String
  fileSize          Int
  mimeType          String            @default("application/pdf")
  storagePath       String
  fileHash          String
  pageCount         Int               @default(0)
  status            PdfImportStatus   @default(PENDING)
  detectedLanguage  String?           @default("bn") // "bn", "en", "mixed"
  category          ExamCategoryType?
  classId           String?
  academicClass     AcademicClass?    @relation(fields: [classId], references: [id], onDelete: SetNull)
  subjectId         String?
  subject           Subject?          @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  chapterId         String?
  chapter           Chapter?          @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  uploadedById      String
  uploadedBy        User              @relation("UserPdfImports", fields: [uploadedById], references: [id], onDelete: Cascade)
  errorMessage      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  processingJobs    PdfProcessingJob[]
  pages             ExtractedDocumentPage[]
  textVersions      DocumentTextVersion[]
  generationJobs    QuestionGenerationJob[]
  generatedDrafts   GeneratedQuestionDraft[]
  importedQuestions Question[]

  @@index([uploadedById])
  @@index([status])
  @@index([fileHash])
}

model PdfProcessingJob {
  id              String       @id @default(uuid())
  pdfImportId     String
  pdfImport       PdfImport    @relation(fields: [pdfImportId], references: [id], onDelete: Cascade)
  stage           String       @default("QUEUED") // "QUEUED", "EXTRACTING", "RUNNING_OCR", "CLEANING", "COMPLETED", "FAILED"
  progressPercent Int          @default(0)
  currentPage     Int          @default(0)
  totalPages      Int          @default(0)
  status          String       @default("PROCESSING") // "PROCESSING", "COMPLETED", "FAILED", "CANCELLED"
  retryCount      Int          @default(0)
  errorMessage    String?
  logsJson        String?      @db.Text
  startedAt       DateTime     @default(now())
  completedAt     DateTime?

  @@index([pdfImportId])
}

model ExtractedDocumentPage {
  id               String       @id @default(uuid())
  pdfImportId      String
  pdfImport        PdfImport    @relation(fields: [pdfImportId], references: [id], onDelete: Cascade)
  pageNumber       Int
  rawText          String       @db.Text
  cleanedText      String       @db.Text
  hasOcr           Boolean      @default(false)
  ocrConfidence    Float?
  wordCount        Int          @default(0)
  detectedLanguage String?      @default("bn")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([pdfImportId, pageNumber])
  @@index([pdfImportId, pageNumber])
}

model DocumentTextVersion {
  id            String       @id @default(uuid())
  pdfImportId   String
  pdfImport     PdfImport    @relation(fields: [pdfImportId], references: [id], onDelete: Cascade)
  versionNumber Int          @default(1)
  pageNumber    Int?         // null means full document
  editedById    String?
  editedBy      User?        @relation("UserTextEdits", fields: [editedById], references: [id], onDelete: SetNull)
  content       String       @db.Text
  diffSummary   String?
  createdAt     DateTime     @default(now())

  @@index([pdfImportId])
}

model QuestionGenerationJob {
  id                String              @id @default(uuid())
  pdfImportId       String
  pdfImport         PdfImport           @relation(fields: [pdfImportId], references: [id], onDelete: Cascade)
  requestedById     String
  requestedBy       User                @relation("UserQuestionGenJobs", fields: [requestedById], references: [id], onDelete: Cascade)
  status            GenerationJobStatus @default(PENDING)
  requestedCount    Int                 @default(10)
  generatedCount    Int                 @default(0)
  approvedCount     Int                 @default(0)
  rejectedCount     Int                 @default(0)
  targetLanguage    String              @default("bn")
  targetDifficulty  DifficultyLevel?
  targetType        AiQuestionType?
  modelUsed         String              @default("gemini-1.5-flash")
  promptTokens      Int?
  completionTokens  Int?
  configJson        String?             @db.Text
  errorMessage      String?
  startedAt         DateTime            @default(now())
  completedAt       DateTime?

  drafts            GeneratedQuestionDraft[]

  @@index([pdfImportId])
  @@index([requestedById])
}

model GeneratedQuestionDraft {
  id                  String               @id @default(uuid())
  jobId               String?
  job                 QuestionGenerationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  pdfImportId         String
  pdfImport           PdfImport            @relation(fields: [pdfImportId], references: [id], onDelete: Cascade)
  questionType        AiQuestionType       @default(MCQ)
  difficulty          DifficultyLevel      @default(MEDIUM)
  status              DraftQuestionStatus  @default(DRAFT)
  questionTextBn      String               @db.Text
  questionTextEn      String?              @db.Text
  stemBn              String?              @db.Text
  stemEn              String?              @db.Text
  optionsJson         String?              @db.Text // JSON: [{ optionKey: "A", textBn: "...", textEn: "...", isCorrect: boolean }]
  correctKey          String?              // "A", "B", "C", "D"
  answerTextBn        String?              @db.Text
  explanationBn       String               @db.Text
  explanationEn       String?              @db.Text
  markingRubric       String?              @db.Text // Step-by-step marking rubric for descriptive questions
  marks               Float                @default(1.0)
  negativeMarks       Float                @default(0.25)
  estimatedSeconds    Int                  @default(60)
  sourcePage          Int?
  sourcePassage       String?              @db.Text
  topicOrConcept      String?
  category            ExamCategoryType
  subjectId           String
  subject             Subject              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapterId           String
  chapter             Chapter              @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  importedQuestionId  String?              @unique
  importedQuestion    Question?            @relation(fields: [importedQuestionId], references: [id], onDelete: SetNull)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  reviewEvents        QuestionReviewEvent[]

  @@index([pdfImportId, status])
  @@index([jobId])
  @@index([subjectId, chapterId])
}

model QuestionReviewEvent {
  id              String                 @id @default(uuid())
  draftId         String
  draft           GeneratedQuestionDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  reviewerId      String
  reviewer        User                   @relation("UserQuestionReviewEvents", fields: [reviewerId], references: [id], onDelete: Cascade)
  action          String                 // "EDIT", "APPROVE", "REJECT", "REGENERATE", "IMPORT"
  previousStatus  String?
  newStatus       String?
  notes           String?
  diffJson        String?                @db.Text
  createdAt       DateTime               @default(now())

  @@index([draftId])
  @@index([reviewerId])
}


